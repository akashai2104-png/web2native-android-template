<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WebViewApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- Navigation bar: keep system default (do NOT paint with theme color) -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.WebViewApp.Splash" parent="Theme.WebViewApp">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
