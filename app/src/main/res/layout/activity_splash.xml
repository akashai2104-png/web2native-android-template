<?xml version="1.0" encoding="utf-8"?>
<!-- TEMPLATE_MARKER:activity_splash_v7 -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        android:layout_marginBottom="60dp">

        <!-- App icon -->
        <ImageView
            android:id="@+id/splashIcon"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="App icon"
            android:layout_marginBottom="28dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- Splash text -->
        <TextView
            android:id="@+id/splashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>

    <!-- Dots loader -->
    <LinearLayout
        android:id="@+id/splashDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:paddingVertical="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <View
            android:id="@+id/splashDot1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="4dp" />

        <View
            android:id="@+id/splashDot2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="4dp" />

        <View
            android:id="@+id/splashDot3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="4dp" />
    </LinearLayout>

    <!-- Circular loading indicator -->
    <ProgressBar
        android:id="@+id/splashProgress"
        style="?android:attr/progressBarStyle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Horizontal progress bar -->
    <ProgressBar
        android:id="@+id/splashProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="180dp"
        android:layout_height="4dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:indeterminate="true"
        android:visibility="gone" />
    <!-- Branding watermark for free tier -->
    <TextView
        android:id="@+id/brandingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="Built with Native App AI"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:paddingVertical="8dp"
        android:visibility="gone" />

</RelativeLayout>
