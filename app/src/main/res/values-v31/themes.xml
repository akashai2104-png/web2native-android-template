<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ system splash screen overrides. Build scripts rewrite this
      file for enabled splash builds. The checked-in default is neutral so
      splash-off launches never show the app icon or configured splash color.
    -->
    <style name="Theme.WebViewApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.WebViewApp</item>
    </style>
</resources>
